# GapGPT OpenAI-compatible API
OPENAI_BASE_URL=https://api.gapgpt.app/v1
OPENAI_API_KEY=PASTE_YOUR_GAPGPT_API_KEY_HERE
OPENAI_MODEL=gpt-5-mini

# REQUIRED: replace with a long random password before starting the container
APP_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Persistent SQLite conversation history (inside container; mount /data to host)
DATA_DIR=/data
